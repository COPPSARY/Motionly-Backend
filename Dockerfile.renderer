FROM node:22.12-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.build.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm run build:api

FROM node:22.12-bookworm-slim

ENV NODE_ENV=production \
    CHROMIUM_PATH=/usr/bin/chromium \
    TZ=UTC

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium ffmpeg fonts-inter fonts-noto-color-emoji ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist

RUN mkdir -p /workspace && chown node:node /workspace /app
USER node

ENTRYPOINT ["node", "/app/dist/apps/renderer/src/worker.js"]
