{
  "name": "motionly_backend",
  "version": "1.0.0",
  "description": "The backend service for [Motionly](../motionly), a code-first motion graphics editor built around TypeScript compositions, HTML/SVG, GSAP timelines, and direct browser preview.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:generation-worker": "node --env-file=.env --watch --import ./scripts/process-identity.mjs --import tsx apps/generation-worker/src/worker.ts",
    "build": "npm run build:api",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "start": "node --env-file=.env dist/apps/api/src/server.js",
    "start:generation-worker": "node --env-file=.env dist/apps/generation-worker/src/worker.js",
    "cleanup:generation-artifacts": "node --env-file=.env dist/apps/generation-worker/src/cleanup.js",
    "docker:build:renderer": "docker build -f Dockerfile.renderer -t motionly-renderer:local .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:auth-ui": "tsc -p apps/auth-test-ui/tsconfig.json --noEmit",
    "db:generate": "node --import ./scripts/process-identity.mjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:reset": "node --env-file=.env --import ./scripts/process-identity.mjs --import tsx packages/database/src/reset.ts",
    "db:migrate": "node --env-file=.env --import ./scripts/process-identity.mjs --import tsx packages/database/src/migrate.ts",
    "eval:cloud-generation": "node --import ./scripts/process-identity.mjs --import tsx evals/cloud-generation/runner.ts",
    "eval:gemini-smoke": "node --env-file-if-exists=.env --import ./scripts/process-identity.mjs --import tsx evals/cloud-generation/gemini-smoke.ts",
    "verify:motionly-baseline": "node scripts/verify-motionly-baseline.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/COPPSARY/Motionly-Backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/COPPSARY/Motionly-Backend/issues"
  },
  "homepage": "https://github.com/COPPSARY/Motionly-Backend#readme",
  "dependencies": {
    "@google/genai": "^2.20.0",
    "@supabase/supabase-js": "^2.112.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer-core": "^25.9.0",
    "vite": "^8.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
